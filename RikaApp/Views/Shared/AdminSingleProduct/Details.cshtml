@model ProductsViewModel
@{
    ViewData["Title"] = Model?.Product?.Title ?? "Unknown Product";
}

<section id="editProduct">
    <div class="container">
        <h2>Edit Product</h2>
        <form asp-controller="AdminSingleProduct" asp-action="UpdateProduct" method="post">

            <input type="hidden" asp-for="Product.ArticleNumber" />

            <div class="form-group">
                <label asp-for="Product.Title"></label>
                <input asp-for="Product.Title" class="form-control" required />
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.Ingress"></label>
                <textarea asp-for="Product.Ingress" class="form-control"></textarea>
                <span asp-validation-for="Product.Ingress" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.Description"></label>
                <textarea asp-for="Product.Description" class="form-control"></textarea>
                <span asp-validation-for="Product.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.Price"></label>
                <input asp-for="Product.Price" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.DiscountPrice"></label>
                <input asp-for="Product.DiscountPrice" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Product.DiscountPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.Manufacturer"></label>
                <input asp-for="Product.Manufacturer" class="form-control" />
                <span asp-validation-for="Product.Manufacturer" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Product.PrimaryImage"></label>
                <input asp-for="Product.PrimaryImage" class="form-control" />
                <span asp-validation-for="Product.PrimaryImage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Update Product</button>
        </form>

        <div class="admin-single-delete mt-3">
            <form asp-controller="AdminSingleProduct" asp-action="DeleteProduct" asp-route-articleNumber="@Model.Product.ArticleNumber" method="post">
                <button type="submit" class="delete-product-button btn btn-danger">Delete</button>
            </form>
        </div>
        <div class="back-to-products">
            <a class="btn btn-primary back-to-index" asp-controller="AdminProductPortal" asp-action="Index">Back to Admin Products Portal</a>
        </div>
        
    </div>
</section>
